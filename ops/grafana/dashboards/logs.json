{
  "uid": "periphshop-logs",
  "title": "PeriphShop — Logs",
  "tags": ["periphshop", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис",
        "type": "custom",
        "current": { "text": "api", "value": "api" },
        "options": [
          { "text": "api", "value": "api", "selected": true },
          { "text": "web", "value": "web" },
          { "text": "mysql", "value": "mysql" }
        ],
        "query": "api,web,mysql"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Записи логов по уровням",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({service=\"$service\"}[5m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "logs",
      "title": "Поток логов",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [{ "expr": "{service=\"$service\"}", "refId": "A" }]
    },
    {
      "type": "logs",
      "title": "Только ошибки и предупреждения",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{service=\"$service\", level=~\"Error|Warning|Fatal\"}", "refId": "A" }]
    }
  ]
}
