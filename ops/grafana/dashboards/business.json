{
  "uid": "periphshop-business",
  "title": "PeriphShop — Business",
  "tags": ["periphshop", "business"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Заказов создано",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "increase(periphshop_orders_created_total[$__range])", "legendFormat": "заказы", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Выручка за период",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "increase(periphshop_order_revenue_rub_total[$__range])", "legendFormat": "руб.", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyRUB", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Средний чек",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "increase(periphshop_order_revenue_rub_total[$__range]) / clamp_min(increase(periphshop_orders_created_total[$__range]), 1)",
          "legendFormat": "руб.",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyRUB", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Товары с низким остатком",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "periphshop_products_low_stock", "legendFormat": "позиций", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Заказы и добавления в корзину",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(periphshop_orders_created_total[15m]) * 3600", "legendFormat": "заказов/час", "refId": "A" },
        { "expr": "rate(periphshop_cart_items_added_total[15m]) * 3600", "legendFormat": "добавлений в корзину/час", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 12 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Выручка (накопительно за час)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "increase(periphshop_order_revenue_rub_total[1h])", "legendFormat": "руб./час", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyRUB" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Отказы оформления по причинам",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(periphshop_checkout_failures_total[15m]) * 3600)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Переходы статусов заказов",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (from, to) (rate(periphshop_order_status_transitions_total[30m]) * 3600)",
          "legendFormat": "{{from}} → {{to}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Попытки входа",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(periphshop_login_attempts_total[15m]) * 3600)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
