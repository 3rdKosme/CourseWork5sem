# Пример переменных окружения стенда PeriphShop.
# Скопируйте в .env и замените значения перед развёртыванием вне учебного контура.
# Файл .env в репозиторий не попадает (раздел 9, п. 8 ТЗ).

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=periphshop
MYSQL_USER=periphshop
MYSQL_PASSWORD=periphshop_change_me
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- MinIO (хранилище изображений) ----------
MINIO_ROOT_USER=periphshop
MINIO_ROOT_PASSWORD=minio_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Приложение ----------
# Ключ подписи JWT: не менее 32 символов (раздел 9, п. 1 ТЗ).
JWT_KEY=please-change-this-development-jwt-signing-key-32
API_PORT=8080
WEB_PORT=80

# ---------- Вспомогательные сервисы ----------
MAILPIT_UI_PORT=8025
ADMINER_PORT=8081

# ---------- Наблюдаемость ----------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_PORT=3100
MYSQLD_EXPORTER_PORT=9104
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8082
MYSQL_EXPORTER_PASSWORD=exporter
